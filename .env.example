# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=job_matcher_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=job_matcher
MYSQL_CONNECT_TIMEOUT_MS=10000

# ChromaDB HTTP server
CHROMA_URL=http://localhost:8000

# HMAC signing key for the HTTP-only session cookie
SESSION_SECRET=replace-with-a-long-random-secret

# The seed script uses a fixed, intentionally non-secret development password.
# Do not use seeded accounts outside a local development database.
SEED_DEVELOPMENT_PASSWORD=ChangeMe123!
